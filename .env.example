# Where the app sends anonymous usage rows (api/usage.ts). Must be a full URL: inside the
# iOS/Android app a relative path would point at the phone itself. Leave unset to send nothing.
VITE_USAGE_ENDPOINT=https://<your-vercel-deployment>/api/usage

# "Send my data" (research data): hidden and refused until set to "on" — only once parental
# consents, the information notice and the DPIA are in place. Set both in Vercel:
#   VITE_RESEARCH_UPLOAD=on   shows the button in Settings
#   RESEARCH_UPLOAD=on        lets api/research.ts accept the data

# Period and app use (team pilots only): whether each day of use was a period day. Health data of
# minors — off until the lawyer, the information notice and the parental consents allow it. Then set
# both in Vercel and redeploy:
#   VITE_PERIOD_STATS=on      the phones send one row per day of use (week, period yes/no, how much use)
#   PERIOD_STATS=on           api/team-usage.ts stores them (usage_days) and the dashboard shows them

# Daily reminder of the web app (api/reminder.ts, api/send-reminders.ts) — set in Vercel, not here:
#   VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY   from: node scripts/vapid-keys.mjs
#   VAPID_SUBJECT                         mailto:<a contact address>, e.g. mailto:info@babsport.com
#   CRON_SECRET                           a long random string, also written in analytics/setup.sql
