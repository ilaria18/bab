# Where the app sends anonymous usage rows (api/usage.ts). Must be a full URL: inside the
# iOS/Android app a relative path would point at the phone itself. Leave unset to send nothing.
VITE_USAGE_ENDPOINT=https://<your-vercel-deployment>/api/usage

# Daily reminder of the web app (api/reminder.ts, api/send-reminders.ts) — set in Vercel, not here:
#   VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY   from: node scripts/vapid-keys.mjs
#   VAPID_SUBJECT                         mailto:<a contact address>, e.g. mailto:info@babsport.com
#   CRON_SECRET                           a long random string, also written in analytics/reminder-cron.sql
